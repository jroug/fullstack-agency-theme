# Demo is the default, including when this variable is absent.
REACT_APP_USE_DEMO_DATA=true
# CMS mode: set demo to false and enter your public WPGraphQL endpoint.
REACT_APP_GRAPHQL_URL=
# Public reCAPTCHA v3 site key; CMS contact form only. Never enter the secret key here.
REACT_APP_GOOGLE_RECAPTCHA_SITE_KEY=
